{
    "name": "@quak/circuit-core",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "Backend-free domain layer shared by the QuaK web IDE and the VSCode extension: DTOs, core gate types, angle formatting and the OpenQASM support matrix.",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./gate-types": "./src/gate-types.ts",
        "./dto/circuit": "./src/dto/circuit.ts",
        "./dto/library": "./src/dto/library.ts",
        "./angle": "./src/angle.ts",
        "./lib/quantumAngle": "./src/lib/quantumAngle.ts",
        "./circuitContent": "./src/circuitContent.ts",
        "./support-matrix": "./src/support-matrix.ts",
        "./circuitIndex": "./src/circuitIndex.ts",
        "./lib/circuitIndex": "./src/lib/circuitIndex.ts",
        "./quantikz": "./src/quantikz.ts",
        "./notation": "./src/notation/index.ts",
        "./notation/quantikz": "./src/notation/quantikz/index.ts",
        "./notation/latex/escape": "./src/notation/latex/escape.ts"
    },
    "scripts": {
        "typecheck": "tsc --noEmit"
    }
}
