{
    "name": "@quak/circuit-editor",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "The circuit editor with its integrated gate library. Backend-free: the host injects the circuit, a setter and the theme.",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./styles.css": "./src/circuit-editor.module.css",
        "./editor.css": "./src/editor.css"
    },
    "imports": {
        "#*": "./src/*"
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@quak/circuit-core": "*",
        "@quak/ui": "*",
        "katex": "^0.16.27",
        "lucide-react": "^0.503.0",
        "react-katex": "^3.1.0"
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@vitejs/plugin-react": "^4.3.4",
        "jsdom": "^27.0.1",
        "vitest": "^4.1.10"
    }
}
