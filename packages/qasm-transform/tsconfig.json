{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2023"],
        "types": [],
        "strict": true,
        "isolatedModules": true,
        "allowImportingTsExtensions": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noEmit": true,
        "skipLibCheck": true
    },
    "include": ["src"],
    // Generated by ANTLR, not written by hand: it does not meet the strictness
    // the rest of the package is held to, and regenerating would undo any fixes.
    "exclude": ["src/generated"]
}
