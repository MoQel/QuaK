# OAuth2 / OIDC Configuration
OIDC_CLIENT_ID=your-google-client-id-here
OIDC_CLIENT_SECRET=your-google-client-secret-here
OIDC_ISSUER=https://accounts.google.com

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:5173

# LSP capacity per backend instance
QUAK_LSP_MAX_PROCESSES=40
QUAK_LSP_MAX_PROCESSES_PER_USER=4

# Guest accounts, enabled by default. Durations use the ISO-8601 format.
# GUEST_MAX_INACTIVITY must exceed the session timeout of one hour.
GUEST_ENABLED=true
GUEST_MAX_INACTIVITY=PT2H
GUEST_CLEANUP_INTERVAL=PT15M
