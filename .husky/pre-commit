# Run Spotless Apply in the backend
if [ -d "backend" ]; then
    echo "Running Spotless Apply in the backend..."
    (cd backend && ./gradlew spotlessApply)

    if ! git diff --quiet -- backend; then
        echo "Spotless changed files. Please review and stage them."
        exit 1
    fi
fi

# Enforce monorepo architecture boundaries (packages/ must not import frontend/).
echo "Checking package boundaries..."
npm run --silent lint:boundaries || {
    echo "❌ Architecture boundary violated. Shared packages must not import from frontend/."
    exit 1
}

cd frontend && npx lint-staged