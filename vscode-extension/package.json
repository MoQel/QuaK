{
    "name": "quak-vscode",
    "displayName": "QuaK",
    "description": "Visual circuit editor for OpenQASM files",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/MoQel/QuaK.git",
        "directory": "vscode-extension"
    },
    "keywords": [
        "openqasm",
        "qasm",
        "quantum",
        "quantum-computing",
        "circuit"
    ],
    "version": "0.0.1",
    "private": true,
    "publisher": "quak",
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "Visualization",
        "Programming Languages"
    ],
    "extensionKind": [
        "workspace"
    ],
    "extensionPack": [
        "orangekame3.vscode-qasm"
    ],
    "main": "./dist/extension.cjs",
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": "limited",
            "description": "The circuit editor is disabled in untrusted workspaces."
        }
    },
    "contributes": {
        "customEditors": [
            {
                "viewType": "quak.circuitEditor",
                "displayName": "QuaK Circuit Editor",
                "selector": [
                    {
                        "filenamePattern": "*.qasm"
                    }
                ],
                "priority": "option"
            }
        ]
    },
    "scripts": {
        "build": "node esbuild.mjs && vite build --config vite.webview.config.ts",
        "package": "npm run build && vsce package --no-dependencies",
        "check:vsix": "node scripts/check-vsix-contents.mjs",
        "watch": "node esbuild.mjs --watch",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:integration": "npm run build && vscode-test"
    },
    "devDependencies": {
        "@quak/circuit-core": "^0.0.0",
        "@quak/circuit-editor": "^0.0.0",
        "@tailwindcss/vite": "^4.3.2",
        "@types/mocha": "^10.0.10",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@types/vscode": "^1.90.0",
        "@vitejs/plugin-react": "^4.7.0",
        "@vscode/test-cli": "^0.0.10",
        "@vscode/test-electron": "^2.5.2",
        "@vscode/vsce": "^3.9.2",
        "esbuild": "^0.25.0",
        "mocha": "^10.8.2",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "tailwindcss": "^4.1.17",
        "tw-animate-css": "^1.4.0",
        "typescript": "~5.7.2",
        "vite": "^6.4.3",
        "vitest": "^3.2.4"
    }
}
