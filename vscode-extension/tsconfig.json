{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2023", "DOM"],
        "types": ["vscode", "mocha"],
        "strict": true,
        "isolatedModules": true,
        "allowImportingTsExtensions": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noEmit": true,
        "skipLibCheck": true
    },
    "include": ["src"]
}
