{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": [
            "ES2023",
            "DOM"
        ],
        "types": [
            "vscode",
            "mocha",
            "node"
        ],
        "strict": true,
        "isolatedModules": true,
        "allowImportingTsExtensions": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noEmit": true,
        "skipLibCheck": true,
        "jsx": "react-jsx",
        "resolveJsonModule": true
    },
    "include": [
        "src",
        "../packages/circuit-editor/src"
    ],
    "exclude": [
        "../packages/circuit-editor/src/**/*.test.ts",
        "../packages/circuit-editor/src/**/*.test.tsx",
        "../packages/circuit-editor/src/test"
    ]
}
