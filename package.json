{
    "name": "quak-monorepo",
    "version": "1.0.0",
    "private": true,
    "description": "QuaK - Quantum Knowledge Editor",
    "scripts": {
        "test": "npm run test:all",
        "test:all": "npm run test:backend & npm run test:frontend & wait",
        "test:backend": "cd backend && ./gradlew test",
        "test:frontend": "cd frontend && npm run test",
        "test:packages": "npm run test --workspace=packages --if-present",
        "test:extension": "cd vscode-extension && npm run test",
        "test:extension:integration": "cd vscode-extension && npm run test:integration",
        "test:sequential": "npm run test:backend && npm run test:frontend",
        "lint": "eslint .",
        "lint:boundaries": "depcruise packages vscode-extension/src --config .dependency-cruiser.cjs",
        "typecheck": "npm run typecheck:frontend && npm run typecheck:packages && npm run typecheck:extension",
        "typecheck:frontend": "cd frontend && npm run typecheck",
        "typecheck:packages": "npm run typecheck --workspace=packages",
        "check:generated": "npm run check:generated --workspace @quak/qasm-transform",
        "typecheck:extension": "cd vscode-extension && npm run typecheck",
        "build:extension": "cd vscode-extension && npm run build",
        "package:extension": "cd vscode-extension && npm run check:vsix",
        "dev:backend": "cd backend && ./gradlew bootRun",
        "dev:frontend": "cd frontend && npm run dev",
        "build": "npm run build:backend",
        "build:backend": "cd backend && ./gradlew buildProduction",
        "build:frontend": "cd frontend && npm run build",
        "prepare": "husky"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "dependency-cruiser": "^18.0.0",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^16.0.0",
        "husky": "^9.1.0",
        "lint-staged": "^16.2.7",
        "prettier": "^3.8.1",
        "typescript-eslint": "^8.72.1",
        "vitest": "^4.1.12"
    },
    "workspaces": [
        "frontend",
        "packages/*",
        "vscode-extension"
    ],
    "dependencies": {
        "@reduxjs/toolkit": "^2.11.2",
        "react-redux": "^9.2.0"
    },
    "lint-staged": {
        "{frontend,vscode-extension}/src/**/*.{js,jsx,ts,tsx,json,css,md}": [
            "prettier --write"
        ],
        "packages/*/src/**/*.{js,jsx,ts,tsx,json,css,md}": [
            "prettier --write"
        ],
        "*.mjs": [
            "prettier --write"
        ],
        "vscode-extension/*.mjs": [
            "prettier --write"
        ]
    },
    "overrides": {
        "dompurify": "^3.4.17",
        "katex": "^0.19.1",
        "vite-plugin-top-level-await": {
            "uuid": "^11.1.1"
        },
        "minimatch": "^11.0.1",
        "glob": "^14.0.2",
        "mocha": {
            "diff": "^8.0.3",
            "serialize-javascript": "^7.1.4"
        }
    }
}
